{
  "name": "EvidenceFlow API",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app/api_main.py"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "sudo apt update && sudo apt install -y libreoffice-writer; pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "api": "uvicorn app.api_main:app --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {"label": "EvidenceFlow API", "onAutoForward": "notify"}
  },
  "forwardPorts": [8000]
}
