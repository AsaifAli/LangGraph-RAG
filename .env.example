# Copy to .env and fill in the credentials you need. Never commit .env.

# LiteLLM provider credentials: set at least ONE. These authenticate LiteLLM
# to the upstream provider. LITELLM_MASTER_KEY below is only the local
# gateway credential and is NOT an OpenRouter/Gemini API key.
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-flash-lite-latest

# Optional alternative chat backend
HF_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct

# Local retrieval models (no API key required after model download)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=jinaai/jina-reranker-v1-turbo-en
SPARSE_MODEL=Qdrant/bm25
DENSE_VECTOR_NAME=dense
SPARSE_VECTOR_NAME=sparse

# Infrastructure
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
TAVILY_API_KEY=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=3
LIBREOFFICE=

# Application identity / retrieval tuning
TENANT_SCHEMA=portfolio_demo
PLATFORM_TENANT_ID=agentic_rag
BACKEND=openrouter
TOP_K=5
MAX_CONCURRENT_SUBAGENTS=3
MAX_RESEARCHER_ITERATIONS=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CSV_OVERLAP_ROWS=1
MAX_WEB_SEARCH_CALLS=1
RERANK_SCORE_THRESHOLD=0.0
RERANK_MIN_RESULTS=2
RAG_SELF_CORRECT_ENABLED=true
MAX_SELF_CORRECT_ROUNDS=2
MAX_SUMMARY_CHUNKS=40
TURN_TIMEOUT_SECONDS=180
HYBRID_PREFETCH_MULTIPLIER=3
FIXTURE_PATH=fixtures/sample_policy_schedule.csv

# Legacy POC_* names remain supported for backward compatibility.

# LLM Gateway (LiteLLM)
LLM_GATEWAY_URL=http://litellm:4000/v1
LLM_GATEWAY_MODEL=portfolio-free
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=

# LiteLLM upstream model IDs
OPENROUTER_LITELLM_MODEL=openrouter/free
GEMINI_LITELLM_MODEL=gemini/gemini-flash-lite-latest

# Streamlit Community Cloud / free hosted demo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=

KATZILLA_ENABLED=true
KATZILLA_MCP_URL=https://api.katzilla.dev/mcp
KATZILLA_API_KEY=
