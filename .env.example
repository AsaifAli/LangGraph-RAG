# Copy to .env and fill in the credentials you need. Never commit .env.

# --- Chat providers ---
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-flash-lite-latest
HF_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- OpenSearch sparse-first retrieval ---
# Local Docker default. No vector database is required.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX=evidenceflow_documents
OPENSEARCH_VERIFY_CERTS=false

# Neural sparse is optional and falls back to lexical retrieval if unavailable.
OPENSEARCH_NEURAL_SPARSE=true
OPENSEARCH_SPARSE_MODEL=amazon/neural-sparse/opensearch-neural-sparse-encoding-doc-v3-distill
OPENSEARCH_SPARSE_TOKENIZER=amazon/neural-sparse/opensearch-neural-sparse-tokenizer-v1
OPENSEARCH_SPARSE_PRUNE_RATIO=0.1
LEXICAL_CANDIDATE_K=40
NEURAL_CANDIDATE_K=40
RERANK_CANDIDATE_K=30
RERANK_ENABLED=true
# local = FastEmbed; jina = hosted Jina API; none = disable reranking
RERANK_BACKEND=local
RERANK_MODEL=jinaai/jina-reranker-v1-turbo-en
JINA_API_KEY=
JINA_API_URL=https://api.jina.ai/v1/rerank
JINA_RERANK_MODEL=jina-reranker-v1-turbo-en

# Agentic retrieval: only used when the first retrieval pass is weak.
AGENTIC_RETRIEVAL_ENABLED=true
MAX_AGENTIC_RETRIEVAL_ROUNDS=2
AGENTIC_RETRIEVAL_MIN_HITS=2
RRF_K=60

# --- External web / primary-source tools ---
TAVILY_API_KEY=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=3
LIBREOFFICE=

# --- Application identity / tuning ---
TENANT_SCHEMA=portfolio_demo
PLATFORM_TENANT_ID=agentic_rag
BACKEND=litellm
TOP_K=5
MAX_CONCURRENT_SUBAGENTS=3
MAX_RESEARCHER_ITERATIONS=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CSV_OVERLAP_ROWS=1
MAX_WEB_SEARCH_CALLS=1
MAX_SUMMARY_CHUNKS=40
TURN_TIMEOUT_SECONDS=180
FIXTURE_PATH=fixtures/sample_policy_schedule.csv

# --- LLM Gateway (LiteLLM) ---
LLM_GATEWAY_URL=http://litellm:4000/v1
LLM_GATEWAY_MODEL=portfolio-free
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=
OPENROUTER_LITELLM_MODEL=openrouter/free
GEMINI_LITELLM_MODEL=gemini/gemini-flash-lite-latest
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

KATZILLA_ENABLED=true
KATZILLA_MCP_URL=https://api.katzilla.dev/mcp
KATZILLA_API_KEY=
